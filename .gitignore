# ==========================================
# BalanceVault - .gitignore
# ==========================================

# 1. Dependency Directories
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 2. Build & Production Outputs
dist/
build/
backend/dist/
frontend/dist/
*.tsbuildinfo

# 3. Environment & Secret Files (Never commit credentials)
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key

# 4. Database & Local Storage Files
*.sqlite
*.sqlite-journal
*.db
*.db-journal
postgres_data/
redis_data/

# 5. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Test Coverage & Tooling Caches
coverage/
.nyc_output/
.vitest/

# 7. Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Temporary & Scratch Files
.tmp/
tmp/
*.bak

