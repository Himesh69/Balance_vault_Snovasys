# BalanceVault Environment Configuration

PORT=4000
NODE_ENV=development

# Database connections (Separate roles per PRD 9.2)
# Migrator role has DDL + DML rights for running migrations
DATABASE_URL_MIGRATE=postgresql://balancevault_migrator:migrator_secret_pass@localhost:5432/balancevault?schema=public

# Application role has DML only (SELECT, INSERT, UPDATE, DELETE) for runtime security
DATABASE_URL=postgresql://balancevault_app:app_secret_pass@localhost:5432/balancevault?schema=public

# Redis connection for rate limiting
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super_secure_jwt_secret_balancevault_2026
JWT_EXPIRES_IN=1h

